# Скопируй в .env и заполни. Файл с токенами в репозиторий не кладётся.

# Бот франшизы — кабинет партнёров.
BOT_TOKEN=

# Кому доступна админка сервиса: id через запятую.
ADMIN_IDS=

# Имя сервиса — подставляется во все карточки.
BRAND=Emoji Partners

# --- Движок дочерних ботов -------------------------------------------
# Папка с кодом бота-конструктора эмодзи. Пусто — берётся вложенная
# engine/ (едет вместе с репозиторием), а если её нет — соседняя папка
# StickerEmojiBot. Франшиза движок не правит, только запускает копии
# с другим токеном и другой папкой данных.
ENGINE_DIR=
ENGINE_ENTRY=bot.py

# Сколько ботов держать запущенными одновременно. Каждый — процесс на
# 150-250 МБ: на контейнере хостинга их влезает единицы. 0 — без
# ограничения, так стоит делать только на своём сервере.
MAX_RUNNING=3

# Куда складывать рабочие папки ботов партнёров (у каждого своя база).
# По умолчанию — data/workspaces рядом с франшизой.
WORKSPACES=

# Сколько ботов разрешено без подписки и с подпиской (0 — без лимита).
FREE_BOTS=1
SUB_BOTS=0

# Как часто пересчитывать продажи дочерних ботов, секунды.
STATS_INTERVAL=300

# Сколько ждать, пока бот представится Telegram, секунды. Первый старт
# дольше: движок считает превью шаблонов.
START_TIMEOUT=90

# --- Ссылки ----------------------------------------------------------
SUPPORT=@EmojiPartners_support
DEMO_BOT=@emojimakerobot
CHANNEL=
GUIDE_URL=https://telegra.ph/

# --- Оформление ------------------------------------------------------
# Баннер над меню: file_id уже загруженной картинки или прямой URL.
# Пусто — возьмётся assets/menu.png, а если и его нет, меню будет
# обычным сообщением.
MENU_PHOTO=

# --- Уровни и подписка -----------------------------------------------
# На сколько процентов подписка снижает комиссию уровня.
SUB_DISCOUNT=2

# Постоянный том хостинга. Здесь лежат база франшизы с токенами
# партнёров и рабочие папки их ботов — самое ценное, что есть у сервиса.
DATA_DIR=
