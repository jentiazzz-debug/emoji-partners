# Токен бота от @BotFather — единственное обязательное поле.
BOT_TOKEN=

# Куда ведёт кнопка «Поддержка»: @username или полная ссылка.
SUPPORT_CONTACT=@your_support

# Необязательно: канал проекта, показывается в разделе поддержки.
SUPPORT_CHAT=

# Обязательная подписка перед созданием эмодзи. Бот должен быть
# администратором этого канала, иначе проверить подписку он не сможет.
# Пустое значение выключает проверку.
REQUIRED_CHANNEL=@emojieditor_news

# Необязательно: ID админов через запятую — у них работает /admin.
ADMIN_IDS=

# Цена в звёздах Telegram за одно эмодзи.
PRICE_PER_EMOJI=1

# Необязательно: как называется набор, который бот создаёт пользователю.
PACK_TITLE=emoji pack

# --- Оплата криптой через @CryptoBot / @send (необязательно) ---
# Токен приложения: @CryptoBot → Crypto Pay → Create App.
# Пустой токен просто выключает этот способ оплаты.
CRYPTO_TOKEN=

# Монета счетов и курс: по умолчанию 1 USDT = 100 звёзд.
CRYPTO_ASSET=USDT
CRYPTO_RATE=0.01

# Тестовая сеть: https://testnet-pay.crypt.bot/api
CRYPTO_API=https://pay.crypt.bot/api
